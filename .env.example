# WAYLINE Canonical Application Configuration
# This identical URL is used by the host PC and all Android phones to access and precache WAYLINE.
# Set this to your stable LAN IP (e.g. http://192.168.0.115:8765) or your permanent HTTPS domain.
VITE_PUBLIC_APP_URL=http://192.168.0.115:8765

# Ports
WAYLINE_PORT=8765
WAYLINE_UDP_PORT=8766
